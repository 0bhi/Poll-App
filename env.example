# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pollapp"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Socket.IO Configuration
# For local development, this points to the separate socket server
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Socket.IO Server Configuration (for socket-server.js)
SOCKET_PORT=3001
FRONTEND_URL="http://localhost:3000"

# Optional: Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: OpenAI (if using moderation features)
OPENAI_API_KEY=""

# Server Configuration
NODE_ENV="development"
PORT=3000
HOSTNAME="localhost"

